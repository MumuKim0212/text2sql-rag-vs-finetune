.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Datasets are re-downloadable, so they stay out; everything under data/results
# is this project's own output and is tracked -- predictions and scores because
# they cost GPU/API time to reproduce, prompts because the script that builds
# them keeps evolving, so a prediction file's exact input is otherwise lost.
# tables.json is tracked because it ships with Spider but is absent from the HF
# dataset.
data/*
!data/.gitkeep
!data/results/
!data/spider/
data/spider/*
!data/spider/tables.json

*.gguf
*.safetensors
checkpoints/
adapters/
# A trained adapter directory as a whole: its weights are 646MB (r=64 across all
# seven projections, saved fp32), past GitHub's 100MB per-file limit, and
# *.safetensors already drops them -- excluding the directory keeps a
# config-and-tokenizer-without-weights half-state from being committed instead.
*_adapter/
adapter/

.env
.env.*

.ipynb_checkpoints/

.mcp.json
